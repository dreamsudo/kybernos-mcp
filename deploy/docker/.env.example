# Copy to .env (or run scripts/gen_keys.sh which writes .env for you).
# LOG_ENC_KEY_HEX: 32-byte hex (openssl rand -hex 32) for AES-256-GCM audit logs.
LOG_ENC_KEY_HEX=
# ANTHROPIC_API_KEY: for the Anthropic provider (the optimized path). Leave blank for local-only.
ANTHROPIC_API_KEY=
# REMOTE_API_KEY: for the OpenAI (or other OpenAI-compatible cloud) provider. Leave blank if unused.
REMOTE_API_KEY=
